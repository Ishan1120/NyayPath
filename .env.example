# ==============================================================================
# NyayPath — Environment Configuration Template (.env.example)
# ==============================================================================
# IMPORTANT:
# - Do NOT commit actual secrets or production keys to version control.
# - Copy this file to '.env' (or '.env.local') and provide environment-specific values.
# - In production, secrets MUST be supplied via secure secrets managers or deployment env.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Infrastructure & Authentication
# ------------------------------------------------------------------------------
# The root HTTPS URL of your Supabase project (e.g., https://your-project.supabase.co or http://127.0.0.1:54321)
SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# The client-side publishable (anon) API key safe for browser consumption
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-anon-key-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-anon-key-here

# The backend service-role secret key (STRICTLY SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
# Grants administrative database and storage bypass privileges for authenticated handlers
SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key-here

# The Supabase JWT HMAC/RSA signing secret used to verify GoTrue authentication tokens
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-minimum-32-characters-here

# ------------------------------------------------------------------------------
# 2. Application Cryptographic Security & Salt Keys
# ------------------------------------------------------------------------------
# Independent application HMAC/HS256 secret for session tokens (minimum 32 characters)
JWT_SECRET=your-app-jwt-secret-minimum-32-characters-here

# High-entropy 256-bit HMAC key used to hash 128-bit citizen case tracking verification keys
# Must be at least 32 characters long
CASE_TRACKING_HMAC_KEY=your-case-tracking-hmac-key-minimum-32-characters-here

# Secret header token to authorize periodic background automation / cron triggers
CRON_SECRET=your-cron-endpoint-secret-key-here

# ------------------------------------------------------------------------------
# 3. AI Services & External Integrations
# ------------------------------------------------------------------------------
# API Key for Groq Cloud LLM engine (legal citations, summarization, doc drafting)
GROQ_API_KEY=gsk_your_groq_api_key_placeholder

# ------------------------------------------------------------------------------
# 4. Networking, Service Endpoints & CORS Configuration
# ------------------------------------------------------------------------------
# Backend API service URL consumed by frontend SSR and client components
BACKEND_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Comma-separated list of allowed CORS origins for FastAPI (no wildcards '*' permitted in production)
# Example: https://nyaypath.gov.in,https://app.nyaypath.gov.in
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 5. Environment & Operational Mode
# ------------------------------------------------------------------------------
# Operational environment: 'development', 'staging', or 'production'
# When set to 'production', all mock fallbacks are disabled and fail-closed security is strictly enforced
ENVIRONMENT=development
NODE_ENV=development
